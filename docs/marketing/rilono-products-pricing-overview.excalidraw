      "seed": 3147,
      "version": 2,
      "versionNonce": 1951965251,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783705430439,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 3,
      "text": "United States: F-1, J-1, M-1; DS-160, I-20, SEVIS, finances, interview readiness.\nUnited Kingdom: Student Visa / Short-Term Study; CAS, IHS, 28-day funds, biometrics.\nCanada: Study Permit / SDS; LOA, PAL/TAL, GIC, tuition receipt, biometrics, POE letter.\nAustralia: Subclass 500; CoE, GTE/GS, OSHC, financial capacity, ImmiAccount, health checks.\nGermany: Type D (Study) / Student Applicant / Language Course; APS, blocked account, health insurance, VIDEX, admission letter.",
      "rawText": "United States: F-1, J-1, M-1; DS-160, I-20, SEVIS, finances, interview readiness.\nUnited Kingdom: Student Visa / Short-Term Study; CAS, IHS, 28-day funds, biometrics.\nCanada: Study Permit / SDS; LOA, PAL/TAL, GIC, tuition receipt, biometrics, POE letter.\nAustralia: Subclass 500; CoE, GTE/GS, OSHC, financial capacity, ImmiAccount, health checks.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "United States: F-1, J-1, M-1; DS-160, I-20, SEVIS, finances, interview readiness.\nUnited Kingdom: Student Visa / Short-Term Study; CAS, IHS, 28-day funds, biometrics.\nCanada: Study Permit / SDS; LOA, PAL/TAL, GIC, tuition receipt, biometrics, POE letter.\nAustralia: Subclass 500; CoE, GTE/GS, OSHC, financial capacity, ImmiAccount, health checks.",
      "lineHeight": 1.25
    },
