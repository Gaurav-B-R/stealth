    {
      "id": "text_M9fQrrdWoFZ0",
      "type": "text",
      "x": 114,
      "y": 1247,
      "width": 1482,
      "height": 215,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
